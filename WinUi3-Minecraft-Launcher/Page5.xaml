<Page
    x:Class="WinUi3_Minecraft_Launcher.Page5"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUi3_Minecraft_Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid UseLayoutRounding="True" HorizontalAlignment="Stretch" MaxWidth="1200" Padding="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：可编辑版本名 -->
        <Border Grid.Row="0" Background="#20FFFFFF" CornerRadius="8" 
                BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Padding="16,16" Margin="0,0,0,20">
            <Grid ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="BackButton_Click" Background="Transparent" BorderThickness="0" Padding="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>

                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="#55FF55" VerticalAlignment="Center">
                    <TextBlock Text="MC" FontSize="16" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBox Grid.Column="2" x:Name="VersionNameTextBox" 
                         Text="加载中..." FontSize="22" FontWeight="Bold" 
                         Background="Transparent" BorderThickness="0" Padding="0"
                         VerticalAlignment="Center" PlaceholderText="输入实例名称" />
            </Grid>
        </Border>

        <!-- 主体：左右分栏 -->
        <Grid Grid.Row="1" ColumnSpacing="20" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="CategoryListView" Grid.Column="0" 
                      Background="#10FFFFFF" CornerRadius="8"
                      BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      SelectionMode="Single" SelectionChanged="CategoryListView_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LoaderItem">
                        <Grid MinHeight="50" Padding="16,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" 
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SelectedVersion, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 右侧面板区 -->
            <Grid Grid.Column="1" HorizontalAlignment="Stretch">

                <TextBlock x:Name="DefaultHintText" Text="纯净原版不需要额外配置，直接点击下方按钮下载。" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel x:Name="FabricPanel" Spacing="15" Visibility="Collapsed">
                    <Border Background="#10FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="选择 Fabric Loader 版本" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ComboBox x:Name="FabricVersionCombo" HorizontalAlignment="Stretch" MinHeight="44" PlaceholderText="正在获取版本..." SelectionChanged="FabricVersionCombo_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="FabricApiPanel" Spacing="15" Visibility="Collapsed">
                    <Border Background="#10FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="20">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Fabric API (前置模组)" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="强烈建议安装。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="FabricApiToggle" IsOn="True" VerticalAlignment="Center" Toggled="FabricApiToggle_Toggled" />
                            </Grid>
                            <ComboBox x:Name="FabricApiVersionCombo" HorizontalAlignment="Stretch" MinHeight="44" PlaceholderText="正在获取 API 版本..." SelectionChanged="FabricApiVersionCombo_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="QuiltPanel" Spacing="15" Visibility="Collapsed">
                    <Border Background="#10FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="选择 Quilt Loader 版本" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ComboBox x:Name="QuiltVersionCombo" HorizontalAlignment="Stretch" MinHeight="44" PlaceholderText="正在获取版本..." SelectionChanged="QuiltVersionCombo_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ForgePanel" Spacing="15" Visibility="Collapsed">
                    <Border Background="#10FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="选择 Forge 版本" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ComboBox x:Name="ForgeVersionCombo" HorizontalAlignment="Stretch" MinHeight="44" PlaceholderText="正在获取版本..." SelectionChanged="ForgeVersionCombo_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 🚨 NeoForge 面板 -->
                <StackPanel x:Name="NeoForgePanel" Spacing="15" Visibility="Collapsed">
                    <Border Background="#10FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="选择 NeoForge 版本" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ComboBox x:Name="NeoForgeVersionCombo" HorizontalAlignment="Stretch" MinHeight="44" PlaceholderText="正在获取版本..." SelectionChanged="NeoForgeVersionCombo_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 🚨 OptiFine 面板 -->
                <StackPanel x:Name="OptiFinePanel" Spacing="15" Visibility="Collapsed">
                    <Border Background="#10FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="选择 OptiFine 版本" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ComboBox x:Name="OptiFineVersionCombo" HorizontalAlignment="Stretch" MinHeight="44" PlaceholderText="正在获取版本..." SelectionChanged="OptiFineVersionCombo_SelectionChanged" />
                            <TextBlock Text="⚠️ OptiFine 官方限制无法完全静默安装，下载后需在弹出的安装器界面手动点击 Install。" FontSize="12" Foreground="Orange" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>

        <Button Grid.Row="2" x:Name="StartDownloadButton" HorizontalAlignment="Center" Height="48" Padding="60,0" CornerRadius="24"
                Background="#0078D4" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,20,0,0" Click="StartDownloadButton_Click">
            <Button.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                    <TextBlock Text="开始下载" x:Name="StartButtonText" />
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>