<Page
    x:Class="WinUi3_Minecraft_Launcher.Page6"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUi3_Minecraft_Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
        <StackPanel Spacing="20" MaxWidth="1000" Padding="0,0,20,20">

            <!-- 指南面板 -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True" Background="#10FFFFFF">
                <Expander.Header>
                    <TextBlock Text="指南" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,10,0,10"/>
                </Expander.Header>
                <StackPanel Spacing="8" Margin="0,0,0,10">

                    <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" BorderThickness="0" Click="OpenUrl_Click" Tag="https://zh.minecraft.wiki/w/%E6%95%99%E7%A8%8B">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE82D;" FontSize="24" Foreground="#55FF55" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Minecraft 教程" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="由社区编写的 Minecraft 教程" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </Expander>

            <!-- 百科面板 -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True" Background="#10FFFFFF">
                <Expander.Header>
                    <TextBlock Text="百科" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,10,0,10"/>
                </Expander.Header>
                <StackPanel Spacing="8" Margin="0,0,0,10">

                    <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" BorderThickness="0" Click="OpenUrl_Click" Tag="https://www.mcmod.cn/">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="24" Foreground="#E81123" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="MC 百科" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="MC 百科：包含大量 Minecraft Mod 信息的中文百科" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" BorderThickness="0" Click="OpenUrl_Click" Tag="https://zh.minecraft.wiki/">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE82D;" FontSize="24" Foreground="#55FF55" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="原版百科" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Minecraft Wiki：包含原版游戏过程中所需大多数知识的中文百科" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" BorderThickness="0" Click="OpenUrl_Click" Tag="https://mineplugin.org/">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="24" Foreground="#FF8C00" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="插件百科" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Plugin Wiki：包含服务端、服务器插件知识的中文百科" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </Expander>

            <!-- 快速访问面板 -->
            <Expander HorizontalAlignment="Stretch" IsExpanded="True" Background="#10FFFFFF">
                <Expander.Header>
                    <TextBlock Text="快速访问" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,10,0,10"/>
                </Expander.Header>
                <StackPanel Spacing="8" Margin="0,0,0,10">

                    <!-- Modrinth -->
                    <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" BorderThickness="0" Click="OpenUrl_Click" Tag="https://modrinth.com/">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE128;" FontSize="24" Foreground="#1BD96A" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Modrinth" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="开源、现代的 Minecraft 模组与资源下载站" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- CurseForge -->
                    <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" BorderThickness="0" Click="OpenUrl_Click" Tag="https://www.curseforge.com/minecraft">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE128;" FontSize="24" Foreground="#F16436" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CurseForge" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="全球最大的 Minecraft 模组、整合包与资源社区" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- 🚨 新增：MCIM 镜像 -->
                    <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" BorderThickness="0" Click="OpenUrl_Click" Tag="https://mod.mcimirror.top/">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="24" Foreground="#0078D4" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="MCIM 镜像源" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="国内加速访问 Modrinth 与 CurseForge 的镜像站" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- 🚨 新增：BMCLAPI -->
                    <Button HorizontalAlignment="Stretch" Padding="12" Background="Transparent" BorderThickness="0" Click="OpenUrl_Click" Tag="https://bmclapi2.bangbang93.com/">
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="24" Foreground="#FF8C00" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="BMCLAPI 镜像" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="国内老牌 Mojang API 镜像，提供原版文件极速下载" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>