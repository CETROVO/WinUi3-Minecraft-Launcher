<Page
    x:Class="WinUi3_Minecraft_Launcher.Page2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUi3_Minecraft_Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid UseLayoutRounding="True" HorizontalAlignment="Stretch" MaxWidth="1200" Padding="20,0,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：分类导航 -->
        <ListView x:ConnectionId='2' x:Name="DownloadCategoryList" Grid.Column="0" 
                  Background="#10FFFFFF" CornerRadius="8"
                  BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  SelectionMode="Single"                                                         
                  Margin="0,0,20,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate                      >
                    <Grid x:ConnectionId='20' MinHeight="50" Padding="16,10">
                        <TextBlock x:ConnectionId='21'                 FontSize="15" FontWeight="SemiBold" 
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 右侧：具体内容面板 -->
        <Grid Grid.Column="1">

            <!-- 1. 游戏面板（原来的功能） -->
            <Grid x:ConnectionId='3' x:Name="GamePanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <RadioButton x:ConnectionId='16' x:Name="ReleaseRadio" Content="正式版" GroupName="VersionType"                               />
                        <RadioButton x:ConnectionId='17' x:Name="SnapshotRadio" Content="预览版" GroupName="VersionType"                               />
                        <RadioButton x:ConnectionId='18' x:Name="AprilFoolsRadio" Content="愚人节版本" GroupName="VersionType"                               />
                    </StackPanel>

                    <Button x:ConnectionId='15' Grid.Column="1"                             Height="32" Padding="12,0" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新列表" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel x:ConnectionId='8' x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="正在从镜像源获取版本列表..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView x:ConnectionId='9' x:Name="VersionListView" 
                              Background="#20FFFFFF" CornerRadius="8"
                              BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                              SelectionMode="Single" IsItemClickEnabled="True"                                      
                              Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate                                 >
                                <Grid x:ConnectionId='11' Margin="0,4" Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:ConnectionId='12' Grid.Column="0" Width="8" Height="8" CornerRadius="4" 
                                            VerticalAlignment="Center"                                />

                                    <TextBlock x:ConnectionId='13' Grid.Column="1"                    FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                    <TextBlock x:ConnectionId='14' Grid.Column="2"                             FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- 2. 模组面板（占位） -->
            <Grid x:ConnectionId='4' x:Name="ModPanel" Visibility="Collapsed">
                <TextBlock Text="1" FontSize="120" FontWeight="Bold" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 3. 资源包面板（占位） -->
            <Grid x:ConnectionId='5' x:Name="ResourcePackPanel" Visibility="Collapsed">
                <TextBlock Text="2" FontSize="120" FontWeight="Bold" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 4. 整合包面板（占位） -->
            <Grid x:ConnectionId='6' x:Name="ModpackPanel" Visibility="Collapsed">
                <TextBlock Text="3" FontSize="120" FontWeight="Bold" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 5. 光影包面板（占位） -->
            <Grid x:ConnectionId='7' x:Name="ShaderpackPanel" Visibility="Collapsed">
                <TextBlock Text="4" FontSize="120" FontWeight="Bold" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

        </Grid>
    </Grid>
</Page>

