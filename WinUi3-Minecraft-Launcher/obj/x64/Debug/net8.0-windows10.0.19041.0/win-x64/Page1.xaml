<Page
    x:Class="WinUi3_Minecraft_Launcher.Page1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUi3_Minecraft_Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SimpleListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ListViewItemPresenter
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            PointerOverBackground="Transparent"
                            PressedBackground="Transparent"
                            SelectedBackground="Transparent"
                            SelectedPointerOverBackground="Transparent"
                            SelectedPressedBackground="Transparent"
                            Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上半部分：已安装版本 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10" Spacing="15">
                <TextBlock Text="已安装的游戏版本" FontSize="20" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button x:ConnectionId='23'                          Background="#0078D4" CornerRadius="4" Height="30">
                    <TextBlock Text="添加版本" Foreground="White" FontSize="13"/>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1">
                <ListView x:ConnectionId='15' x:Name="VersionListView"
                          Background="#20FFFFFF" CornerRadius="8"
                          BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          ItemContainerStyle="{StaticResource SimpleListViewItemStyle}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate                               >
                            <Grid x:ConnectionId='18' Margin="0,2" Padding="4" ColumnSpacing="12" UseLayoutRounding="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon x:ConnectionId='19' Grid.Column="0" Glyph="&#xE73E;" FontSize="16" Foreground="#0078D4" Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                                                                             />

                                <TextBlock x:ConnectionId='20' Grid.Column="1"                                         
                                           FontWeight="SemiBold" FontSize="15"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:ConnectionId='21'                                              Height="30" CornerRadius="4" Padding="14,0">
                                        <TextBlock Text="选择" FontSize="13"/>
                                    </Button>
                                    <Button x:ConnectionId='22'                                            Height="30" CornerRadius="4" Padding="14,0">
                                        <TextBlock Text="详情" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:ConnectionId='16' x:Name="VersionEmptyHint"
                           Text="👋 请点击下方的「添加文件夹」按钮，选择你的 .minecraft 目录"
                           FontSize="14" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- 下半部分：.minecraft 文件夹 -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10" Spacing="15">
                <TextBlock Text=".minecraft 游戏文件夹" FontSize="20" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button x:ConnectionId='14'                         Background="#0078D4" CornerRadius="4" Height="30">
                    <TextBlock Text="添加文件夹" Foreground="White" FontSize="13"/>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1">
                <ListView x:ConnectionId='4' x:Name="FolderListView"
                          Background="#20FFFFFF" CornerRadius="8"
                          BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          ItemContainerStyle="{StaticResource SimpleListViewItemStyle}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate                                   >
                            <Grid x:ConnectionId='7' Margin="0,2" Padding="4" ColumnSpacing="12" UseLayoutRounding="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon x:ConnectionId='8' Grid.Column="0" Glyph="&#xE73E;" FontSize="16" Foreground="#0078D4" Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                                                                             />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                    <TextBlock x:ConnectionId='12'                                          FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock x:ConnectionId='13'                      FontSize="12"
                                               FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:ConnectionId='9'                                           Height="30" CornerRadius="4" Padding="14,0">
                                        <TextBlock Text="切换" FontSize="13"/>
                                    </Button>
                                    <Button x:ConnectionId='10'                                           Height="30" CornerRadius="4" Padding="14,0">
                                        <TextBlock Text="重命名" FontSize="13"/>
                                    </Button>
                                    <Button x:ConnectionId='11'                                           Height="30" CornerRadius="4" Padding="14,0">
                                        <TextBlock Text="移除" FontSize="13" Foreground="#E81123"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:ConnectionId='5' x:Name="FolderEmptyHint"
                           Text="📂 还没有添加任何 .minecraft 文件夹，点击上方「添加文件夹」开始"
                           FontSize="14" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Page>

