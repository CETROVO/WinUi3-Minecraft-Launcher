<Page
    x:Class="WinUi3_Minecraft_Launcher.Page2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUi3_Minecraft_Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid UseLayoutRounding="True" HorizontalAlignment="Stretch" Padding="20,0,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：分类导航 -->
        <ListView x:Name="DownloadCategoryList" Grid.Column="0" 
                  Background="#10FFFFFF" CornerRadius="8"
                  BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  SelectionMode="Single" SelectionChanged="DownloadCategoryList_SelectionChanged"
                  Margin="0,0,20,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid MinHeight="50" Padding="16,10">
                        <TextBlock Text="{x:Bind}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 右侧：内容区 -->
        <Grid Grid.Column="1">

            <!-- 1. 游戏面板（原版下载） -->
            <Grid x:Name="GamePanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 合规提示文字 -->
                <Border x:Name="GameBanWarning" Grid.Row="0" Background="#20E81123" BorderBrush="#E81123" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#E81123" VerticalAlignment="Center"/>
                        <TextBlock Text="为遵守相关法律法规，WML 暂时不再为中华人民共和国提供 MC 游戏下载功能。" Foreground="#E81123" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ContentControl x:Name="GameDownloadContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <RadioButton x:Name="ReleaseRadio" Content="正式版" GroupName="VersionType" Checked="VersionType_Checked" />
                                <RadioButton x:Name="SnapshotRadio" Content="预览版" GroupName="VersionType" Checked="VersionType_Checked" />
                                <RadioButton x:Name="AprilFoolsRadio" Content="愚人节版本" GroupName="VersionType" Checked="VersionType_Checked" />
                            </StackPanel>

                            <Button Grid.Column="2" Click="RefreshButton_Click" Height="32" Padding="10,0" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="刷新" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <ProgressRing IsActive="True" Width="40" Height="40" />
                                <TextBlock Text="正在获取版本列表..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ListView x:Name="VersionListView" Background="#20FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="VersionListView_ItemClick" Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RemoteVersion">
                                        <Grid Margin="0,4" Padding="8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{x:Bind DotColor}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ReleaseTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </ContentControl>
            </Grid>

            <!-- 2. 社区资源搜索面板 -->
            <Grid x:Name="SearchPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 整合包合规提示 -->
                <Border x:Name="ModpackBanWarning" Grid.Row="0" Background="#20E81123" BorderBrush="#E81123" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="#E81123" VerticalAlignment="Center"/>
                        <TextBlock Text="为遵守相关法律法规，WML 暂时不再为中华人民共和国提供整合包下载功能。" Foreground="#E81123" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="使用英文从 Modrinth 搜索..." Height="38" KeyDown="SearchBox_KeyDown" />
                    <Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Click="SearchButton_Click" Background="#0078D4" Foreground="White" Height="38" Padding="20,0" CornerRadius="4" />
                </Grid>

                <StackPanel x:Name="InstanceSelectionPanel" Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" Foreground="#0078D4"/>
                    <TextBlock Text="安装至：" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TargetInstanceComboBox" MinWidth="300" Height="32" SelectionChanged="TargetInstanceComboBox_SelectionChanged" PlaceholderText="请选择目标版本..."/>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ListTitleText" Grid.Row="0" Text="" FontSize="16" FontWeight="Bold" Margin="5,0,0,10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

                    <StackPanel Grid.Row="1" x:Name="SearchLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="正在加载..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="SearchResultList" Background="#10FFFFFF" CornerRadius="8" SelectionMode="None" Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ModrinthProject">
                                <Grid MinHeight="70" Padding="16,10" ColumnSpacing="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="50" Height="50" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
                                        <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{x:Bind Downloads}" FontSize="12" Foreground="Gray" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="获取下载" Tag="{x:Bind}" Click="DownloadResource_Click" Height="32" CornerRadius="4" Background="#55FF55" Foreground="Black" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" x:Name="DownloadStatusBorder" Background="#20FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="DownloadStatusText" Grid.Row="0" Text="正在请求下载..." FontSize="13" Foreground="Orange" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="DownloadProgressBar" Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="0" CornerRadius="4" Foreground="#0078D4" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DownloadProgressText" Grid.Column="1" Text="0%" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. Java 面板 -->
            <Grid x:Name="JavaPanel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Spacing="15">
                    <Border Background="#10FFFFFF" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Java 运行环境下载" FontSize="16" FontWeight="SemiBold" Foreground="#0078D4" />
                            <TextBlock Text="Minecraft 需要 Java 才能运行。如果您没有安装，或者游戏启动报错，请在此处选择对应版本进行下载安装。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>

                            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,10">
                                <RadioButton x:Name="JreRadio" Content="JRE (仅运行游戏)" GroupName="JavaType" IsChecked="True" ToolTipService.ToolTip="体积较小，适合只玩游戏的玩家"/>
                                <RadioButton x:Name="JdkRadio" Content="JDK (运行 + 开发/开发模组)" GroupName="JavaType" ToolTipService.ToolTip="包含 JRE 及开发工具，适合模组开发者"/>
                            </StackPanel>

                            <ComboBox x:Name="JavaVersionCombo" HorizontalAlignment="Stretch" MinHeight="44" PlaceholderText="正在获取可用版本..." />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="DownloadJavaButton" Content="下载并安装 Java" HorizontalAlignment="Stretch" Height="40" Background="#0078D4" Foreground="White" CornerRadius="4" Click="DownloadJavaButton_Click"/>
                                <Button x:Name="CancelJavaButton" Content="取消下载" HorizontalAlignment="Stretch" Height="40" Background="#E81123" Foreground="White" CornerRadius="4" Click="CancelJavaButton_Click" Visibility="Collapsed"/>
                            </StackPanel>

                            <Grid ColumnSpacing="10" Margin="0,10,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="JavaDownloadProgress" Grid.Column="0" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" CornerRadius="3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="JavaDownloadSpeedText" Grid.Column="1" Text="0 KB/s" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>

                            <TextBlock x:Name="JavaStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Page>