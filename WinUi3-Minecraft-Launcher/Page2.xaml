<Page
    x:Class="WinUi3_Minecraft_Launcher.Page2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUi3_Minecraft_Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid UseLayoutRounding="True" HorizontalAlignment="Stretch" Padding="20,0,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：分类导航 -->
        <ListView x:Name="DownloadCategoryList" Grid.Column="0" 
                  Background="#10FFFFFF" CornerRadius="8"
                  BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  SelectionMode="Single" SelectionChanged="DownloadCategoryList_SelectionChanged"
                  Margin="0,0,20,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid MinHeight="50" Padding="16,10">
                        <TextBlock Text="{x:Bind}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 右侧：内容区 -->
        <Grid Grid.Column="1">

            <!-- 1. 游戏面板（原版下载） -->
            <Grid x:Name="GamePanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <RadioButton x:Name="ReleaseRadio" Content="正式版" GroupName="VersionType" Checked="VersionType_Checked" />
                        <RadioButton x:Name="SnapshotRadio" Content="预览版" GroupName="VersionType" Checked="VersionType_Checked" />
                        <RadioButton x:Name="AprilFoolsRadio" Content="愚人节版本" GroupName="VersionType" Checked="VersionType_Checked" />
                    </StackPanel>

                    <ComboBox Grid.Column="2" x:Name="SourceComboBox" Width="130" Height="32" VerticalAlignment="Center" Margin="0,0,10,0" SelectionChanged="SourceComboBox_SelectionChanged">
                        <ComboBoxItem Content="自动 (推荐)" />
                        <ComboBoxItem Content="官方源" />
                        <ComboBoxItem Content="镜像源" />
                    </ComboBox>

                    <Button Grid.Column="3" Click="RefreshButton_Click" Height="32" Padding="10,0" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="刷新" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="正在获取版本列表..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView x:Name="VersionListView" Background="#20FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="VersionListView_ItemClick" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RemoteVersion">
                                <Grid Margin="0,4" Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{x:Bind DotColor}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ReleaseTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- 2. 社区资源搜索面板 -->
            <Grid x:Name="SearchPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 搜索框 -->
                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="输入关键字搜索 (按回车搜索)..." Height="38" KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Content="搜索" Click="SearchButton_Click" Background="#0078D4" Foreground="White" Height="38" Padding="20,0" CornerRadius="4" />
                </Grid>

                <!-- 目标实例选择 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" Foreground="#0078D4"/>
                    <TextBlock Text="安装至：" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TargetInstanceComboBox" MinWidth="300" Height="32" SelectionChanged="TargetInstanceComboBox_SelectionChanged" PlaceholderText="请选择目标版本..."/>
                </StackPanel>

                <!-- 搜索结果列表 & 状态栏 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" x:Name="SearchLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="正在搜索..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView Grid.Row="0" x:Name="SearchResultList" Background="#10FFFFFF" CornerRadius="8" SelectionMode="None" Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ModrinthProject">
                                <Grid MinHeight="70" Padding="16,10" ColumnSpacing="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="50" Height="50" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
                                        <Image Source="{x:Bind ImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{x:Bind Downloads}" FontSize="12" Foreground="Gray" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="获取下载" Tag="{x:Bind}" Click="DownloadResource_Click" Height="32" CornerRadius="4" Background="#55FF55" Foreground="Black" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 🚨 新增：底部重试状态栏 -->
                    <Border Grid.Row="1" x:Name="DownloadStatusBorder" Background="#20FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <ProgressRing IsActive="True" Width="16" Height="16" Foreground="Orange"/>
                            <TextBlock x:Name="DownloadStatusText" Text="正在请求下载..." FontSize="13" Foreground="Orange" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Page>